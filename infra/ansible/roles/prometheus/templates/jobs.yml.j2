- job_name: vm-geradora
  scrape_interval: {{ prometheus_scrape_interval }}
  static_configs:
{% for host in groups['simulator'] %}
    - targets: [{{ ((hostvars[host].ansible_host | default(host)) ~ ':' ~ node_exporter_port) | to_json }}]
      labels:
        vm: {{ host | to_json }}
{% endfor %}
{% if simulator_metrics_enabled | bool %}
- job_name: aplicacao-geradora
  scrape_interval: {{ prometheus_scrape_interval }}
  static_configs:
{% for host in groups['simulator'] %}
    - targets: [{{ ((hostvars[host].ansible_host | default(host)) ~ ':' ~ simulator_metrics_port) | to_json }}]
      labels:
        vm: {{ host | to_json }}
{% endfor %}
{% endif %}
