      "targets": [
        {
          "refId": "A",
          "expr": "node_time_seconds{job=\"vm-geradora\",instance=~\"$instance\"} - node_boot_time_seconds{job=\"vm-geradora\",instance=~\"$instance\"}",
          "legendFormat": "{{vm}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "[[ grafana_datasource_uid ]]"
