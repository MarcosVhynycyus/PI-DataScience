services:
  grafana:
    image: {{ grafana_image | to_json }}
    restart: unless-stopped
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
    secrets:
      - grafana_admin_password
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/monitoring/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - /opt/monitoring/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - /opt/monitoring/grafana/dashboards:/var/lib/grafana/dashboards-vm:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
secrets:
  grafana_admin_password:
    file: ./grafana_admin_password
volumes:
  grafana_data:
